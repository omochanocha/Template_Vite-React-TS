{
  "name": "template-vite-react-ts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint:oxlint": "oxlint --type-aware",
    "lint:oxlint:fix": "oxlint --type-aware --fix",
    "lint:style": "stylelint 'src/**/*.{css,less,sass,scss}'",
    "lint:style:fix": "stylelint --fix 'src/**/*.{css,less,sass,scss}'",
    "lint": "npm run --silent lint:style; ST=$?; npm run --silent lint:oxlint; ES=$?; [ $ST -eq 0 ] && [ $ES -eq 0 ]",
    "lint:fix": "npm run --silent lint:style:fix; ST=$?; npm run --silent lint:oxlint:fix; ES=$?; [ $ST -eq 0 ] && [ $ES -eq 0 ]",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "preinstall": "npx typesync || :"
  },
  "dependencies": {
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^22.19.17",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "lefthook": "^1.13.6",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "stylelint": "^16.26.1",
    "stylelint-config-recess-order": "^6.1.0",
    "stylelint-config-standard": "^38.0.0",
    "stylelint-order": "^7.0.1",
    "typescript": "^7.0.2",
    "vite": "^6.4.2",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
